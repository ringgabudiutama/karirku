# Postgres (Vercel Postgres / Neon) — connection string with pooling
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, used by Prisma Migrate
DIRECT_URL="postgres://user:password@host/dbname?sslmode=require"

# Generate a long random string, e.g: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Auto-filled by Vercel when you connect a Blob store to the project
BLOB_READ_WRITE_TOKEN=""
